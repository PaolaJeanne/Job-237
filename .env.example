# Core Django runtime
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# En production, DJANGO_ENV=production impose un secret reel et DEBUG=False
# (le demarrage echoue sinon, voir backend/job237/settings.py)

# URL publique du frontend (utilisee dans les emails de reset)
FRONTEND_URL=http://localhost:5173

# Email
# Dev: backend console (les emails s'affichent dans le terminal). Rien a configurer.
# Prod: SMTP reel, ex. SendGrid / Mailgun / Postmark.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=xxxx
# DEFAULT_FROM_EMAIL=Job237 <noreply@job237.cm>

# Security / HTTPS production flags
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Optional future PostgreSQL values
POSTGRES_DB=job237
POSTGRES_USER=job237
POSTGRES_PASSWORD=job237_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DJANGO_USE_POSTGRES=False
